# Back-end environment. Copy to `.env` for local development.
# Every variable the back end reads is listed here; the defaults suit local development only.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database: matches the MongoDB started by `docker compose up` at the repository root
MONGODB_URI=mongodb://localhost:27017/auth

# Signing secret for access tokens (HS256). Replace with a long random value outside local development.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789

# Front-end origins allowed by CORS and by the Origin check on the cookie routes (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Session lifetimes (ADR 0001)
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
REFRESH_GRACE_SECONDS=10

# scrypt cost as log2 N
PASSWORD_HASH_COST=17

# Set the refresh cookie's Secure attribute; true in production
COOKIE_SECURE=false

# Sign up and Sign in attempts allowed per IP address in each window
THROTTLE_LIMIT=20
THROTTLE_TTL_SECONDS=60

# Largest request body accepted (a number and kb or mb)
REQUEST_BODY_LIMIT=16kb
