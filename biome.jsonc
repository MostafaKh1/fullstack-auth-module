{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Biome lints; Prettier formats (ADR 0004). The formatter stays off so the two never fight.
  "formatter": { "enabled": false },
  // The back end's layering rules that noRestrictedImports cannot express (ADR 0005).
  "plugins": [
    { "path": "./backend/lint/no-cross-feature-import.grit", "includes": ["backend/src/features/**"] },
    {
      "path": "./backend/lint/no-feature-import-below-features.grit",
      "includes": [
        "backend/src/config/**",
        "backend/src/logging/**",
        "backend/src/core/**",
        "backend/src/database/**",
        "backend/src/common/**",
      ],
    },
  ],
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    // Installed skills are vendored from upstream, not our code.
    "includes": ["**", "!.claude/skills", "!.agents/skills", "!**/package-lock.json"],
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Application code logs through the injected pino logger (CODING_STANDARDS.md).
        "noConsole": "error",
      },
    },
  },
  "javascript": {
    "parser": {
      // NestJS injects through parameter decorators.
      "unsafeParameterDecoratorsEnabled": true,
    },
  },
  "css": {
    "parser": {
      "tailwindDirectives": true,
    },
  },
  "overrides": [
    // The front end imports through @/; the structure check also confines ./ to component folders, which a glob
    // cannot tell apart from kind folders. Radix is reached only through primitives/, so the behaviour it provides
    // lives in one layer (ADR 0011); the primitives override repeats the ../ ban, as the last match wins.
    {
      "includes": ["frontend/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../**", "**/../**", "**/.."],
                    "message": "Import through @/ (the front end's src/), never a parent-relative path.",
                  },
                  {
                    "group": ["@radix-ui/**"],
                    "message": "Radix is wrapped once in src/components/primitives/: import the primitive.",
                  },
                ],
              },
            },
          },
        },
      },
    },
    {
      "includes": ["frontend/src/components/primitives/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../**", "**/../**", "**/.."],
                    "message": "Import through @/ (the front end's src/), never a parent-relative path.",
                  },
                ],
              },
            },
          },
        },
      },
    },
    {
      "includes": ["backend/**"],
      "linter": {
        "rules": {
          // An `import type` of an injected class erases it at runtime and breaks Nest DI.
          "style": { "useImportType": "off" },
          // A Nest dynamic module is a decorated class with a static `forRoot`; a function cannot carry `@Module`.
          "complexity": { "noStaticOnlyClass": "off" },
        },
      },
    },
    // The back end's layering (ADR 0010). A file matching several overrides takes the last one's options, so each
    // repeats the restrictions of the ones before it. The test harness reaches the raw database on purpose.
    {
      "includes": ["backend/src/**", "!backend/src/database/**", "!backend/src/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "mongoose": "Only src/database/ talks to MongoDB: go through a repository.",
                  "@nestjs/mongoose": "Only src/database/ talks to MongoDB: go through a repository.",
                },
                "patterns": [
                  {
                    "group": ["../**", ".."],
                    "message": "Import through @/ (the source root); only a sibling in the same folder uses ./.",
                  },
                  {
                    "group": ["**/database/collections/**"],
                    "message": "Only repositories read collections; import the domain type from src/common/types/.",
                  },
                ],
              },
            },
          },
        },
      },
    },
    // src/database/ is the one place that reaches Mongoose and the collections, so the rules above leave it out;
    // it still imports across folders through @/.
    {
      "includes": ["backend/src/database/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", ".."],
                    "message": "Import through @/ (the source root); only a sibling in the same folder uses ./.",
                  },
                ],
              },
            },
          },
        },
      },
    },
    {
      "includes": [
        "backend/src/**/*.service.ts",
        "!backend/src/features/auth/services/auth-cookies.service.ts",
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "mongoose": "Only src/database/ talks to MongoDB: go through a repository.",
                  "@nestjs/mongoose": "Only src/database/ talks to MongoDB: go through a repository.",
                  "express": "A service knows nothing about HTTP: the controller extracts the request and sets the cookie.",
                },
                "patterns": [
                  {
                    "group": ["../**", ".."],
                    "message": "Import through @/ (the source root); only a sibling in the same folder uses ./.",
                  },
                  {
                    "group": ["**/database/collections/**"],
                    "message": "Only repositories read collections; import the domain type from src/common/types/.",
                  },
                  {
                    "group": ["**/auth-cookies.service.js"],
                    "message": "A service never touches a cookie: the controller calls AuthCookiesService.",
                  },
                ],
              },
            },
          },
        },
      },
    },
    {
      "includes": ["backend/src/**/*.controller.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "mongoose": "Only src/database/ talks to MongoDB: go through a repository.",
                  "@nestjs/mongoose": "Only src/database/ talks to MongoDB: go through a repository.",
                },
                "patterns": [
                  {
                    "group": ["../**", ".."],
                    "message": "Import through @/ (the source root); only a sibling in the same folder uses ./.",
                  },
                  {
                    "group": ["**/database/**", "**/clock.service.js", "**/app-config.service.js"],
                    "message": "A controller is the API only: the business rule, the time and the configuration belong in a service.",
                  },
                ],
              },
            },
          },
        },
      },
    },
    // Every back-end file, tests included, imports across folders through @/.
    {
      "includes": ["backend/src/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", ".."],
                    "message": "Import through @/ (the source root); only a sibling in the same folder uses ./.",
                  },
                ],
              },
            },
          },
        },
      },
    },
  ],
}
