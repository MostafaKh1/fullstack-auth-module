language js

// noRestrictedImports cannot say "any folder but common/", and a relative path names its target only against the
// importer's depth, so the importer's own path (features/<a>/ and the folders below it) picks the pattern. From a file
// <n> folders below features/<a>/, <n> + 1 `../` reach features/ (another feature, or this one the long way round)
// and <n> + 2 reach src/, where only common/ may be named. The ladder covers four levels below a feature's folder.
or {
  `import $_ from $source`,
  `import type $_ from $source`,
  `import $source`,
  `export { $_ } from $source`,
  `export type { $_ } from $source`,
  `export * from $source`,
  `import($source)`
} where {
  or {
    and {
      $filename <: r".*[/\\]features[/\\][a-z0-9-]+[/\\][^/\\]+",
      $source <: r"[\"'](?:\.\./){1}.*[\"']",
      not $source <: r"[\"'](?:\.\./){2}common/.*[\"']"
    },
    and {
      $filename <: r".*[/\\]features[/\\][a-z0-9-]+(?:[/\\][^/\\]+){2}",
      $source <: r"[\"'](?:\.\./){2}.*[\"']",
      not $source <: r"[\"'](?:\.\./){3}common/.*[\"']"
    },
    and {
      $filename <: r".*[/\\]features[/\\][a-z0-9-]+(?:[/\\][^/\\]+){3}",
      $source <: r"[\"'](?:\.\./){3}.*[\"']",
      not $source <: r"[\"'](?:\.\./){4}common/.*[\"']"
    },
    and {
      $filename <: r".*[/\\]features[/\\][a-z0-9-]+(?:[/\\][^/\\]+){4}",
      $source <: r"[\"'](?:\.\./){4}.*[\"']",
      not $source <: r"[\"'](?:\.\./){5}common/.*[\"']"
    }
  },
  register_diagnostic(
    span=$source,
    message="A contract feature never imports another feature: code two features use belongs in src/common/."
  )
}
