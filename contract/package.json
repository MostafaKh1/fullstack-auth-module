{
  "name": "@app/contract",
  "version": "0.0.0",
  "private": true,
  "description": "The API contract both apps build from: every route, its schemas and its errors, written with oRPC (ADR 0012).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./common/*": {
      "types": "./dist/common/*.d.ts",
      "default": "./dist/common/*.js"
    },
    "./*": {
      "types": "./dist/features/*.d.ts",
      "default": "./dist/features/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@orpc/contract": "1.16.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
